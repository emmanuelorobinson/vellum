{
  "name": "vellum-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Vellum: design where your code lives. Monorepo root (Cargo workspace + pnpm workspaces + Turborepo).",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "release:status": "node scripts/release.mjs status",
    "release:gate": "node scripts/release.mjs gate",
    "security:check": "node scripts/security.mjs check",
    "security:fuzz": "node scripts/security.mjs fuzz",
    "security:sbom": "node scripts/security.mjs sbom",
    "security:canary": "node scripts/model-providers.mjs --session",
    "dev": "turbo run dev",
    "build": "turbo run //#cargo:build //#wasm:build build",
    "lint": "turbo run //#lint:ts //#lint:rust",
    "type-check": "turbo run //#cargo:check type-check",
    "test": "turbo run //#cargo:test //#test:scripts test",
    "test:watch": "turbo watch test",
    "format": "biome format --write . && cargo fmt --all",
    "format:check": "biome format . && cargo fmt --all --check",
    "refs": "bash scripts/refs.sh && node scripts/reference-index.mjs --check",
    "refs:index": "node scripts/reference-index.mjs",
    "deps:check": "bash scripts/check-deps.sh",
    "clean-room": "bash scripts/check-clean-room.sh",
    "copy-lint": "node scripts/copy-lint.mjs",
    "cargo:deny": "cargo deny check",
    "types:gen": "node scripts/types-gen.mjs",
    "types:check": "node scripts/types-gen.mjs --check",
    "format-spec:gen": "node scripts/gen-format.mjs",
    "format-spec:check": "node scripts/gen-format.mjs --check",
    "layout-oracle": "bash scripts/gen-layout-oracle.sh",
    "design:open": "bash scripts/design-open",
    "design:snapshot": "bash scripts/design-snapshot",
    "design:check": "bash scripts/design-check",
    "design:tokens": "bash scripts/design-tokens",
    "ui-icons:gen": "node scripts/ui-icons-gen.mjs",
    "ui-icons:check": "node scripts/ui-icons-gen.mjs --check",
    "tokens:check": "node scripts/design-tokens.mjs --check",
    "tokens:lint": "node scripts/token-lint.mjs",
    "fixtures:record": "bash scripts/record-engine-fixtures.sh",
    "checksum": "node scripts/spec-checksums.mjs check",
    "checksum:update": "node scripts/spec-checksums.mjs update",
    "clean": "node scripts/clean.mjs",
    "cargo:build": "node scripts/skia-build.mjs build --workspace",
    "cargo:check": "node scripts/skia-build.mjs check --workspace --all-targets",
    "cargo:test": "node scripts/skia-build.mjs test --workspace",
    "wasm:build": "node scripts/skia-build.mjs build --release -p vellum-wasm --bin vellum-editor --target wasm32-unknown-emscripten && node scripts/skia-build.mjs build --release -p vellum-wasm --no-default-features --bin vellum-viewer --target wasm32-unknown-emscripten",
    "lint:ts": "biome check . && node scripts/copy-lint.mjs && node scripts/token-lint.mjs",
    "lint:rust": "node scripts/skia-build.mjs clippy --workspace --all-targets -- -D warnings",
    "test:scripts": "node --test \"scripts/__tests__/*.test.mjs\"",
    "doc-api:gen": "node scripts/doc-api-gen.mjs",
    "doc-api:check": "node scripts/doc-api-gen.mjs --check",
    "parity:check": "node scripts/parity.mjs",
    "test:model-providers": "node scripts/model-providers.mjs",
    "performance:native": "node scripts/performance.mjs native",
    "performance:browser": "node scripts/performance.mjs browser"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "dependency-cruiser": "18.5.0",
    "turbo": "2.11.7",
    "typescript": "catalog:"
  }
}
