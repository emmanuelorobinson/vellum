# Reference repositories: cloned by scripts/refs.sh, read-only, never committed
refs/

# Rust
target/

# Read-only working copy of the design file (scripts/design-open)
.design-cache/

# Secrets and local environment. Keys live in the OS keychain, never in files.
.env*
!.env.example

# Crash-recovery copies are not history; Git is
*.vellum.recovery

# Node / pnpm / Turborepo
node_modules/
.turbo/
dist/
.next/
next-env.d.ts
coverage/
*.tsbuildinfo

# OS / editors
.DS_Store
Thumbs.db
.idea/
*.swp

# Design snapshot PNGs: regenerated locally by pnpm design:snapshot. Only inventory.json is committed.
docs/design/snapshots/*.png
docs/design/snapshots/foundations/*.png
docs/design/snapshots/components/*.png

*storybook.log
storybook-static
