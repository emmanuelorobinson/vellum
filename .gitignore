# Reference repositories: cloned by scripts/refs.sh, read-only, never committed
refs/

# Rust
target/

# Read-only working copy of the design file (scripts/design-open)
.design-cache/

# Secrets and local environment. Keys live in the OS keychain, never in files.
.env*
!.env.example

# Crash-recovery copies are not history; Git is
*.vellum.recovery

# Node / pnpm / Turborepo
node_modules/
.turbo/
dist/
.next/
next-env.d.ts
coverage/
*.tsbuildinfo

# OS / editors
.DS_Store
Thumbs.db
.idea/
*.swp

# Design snapshot PNGs: regenerated locally by pnpm design:snapshot. Only inventory.json is committed.
docs/design/snapshots/*.png
docs/design/snapshots/foundations/*.png
docs/design/snapshots/components/*.png

*storybook.log
storybook-static

# Playwright output (editor browser tests)
test-results/
playwright-report/
# Built shared viewer renderer, staged by scripts/web-assets.mjs.
apps/account/public/engine/
apps/web/public/engine/
apps/web/public/fonts/

# Optional sync service data (canonical snapshots, SQL/WAL, no credentials).
.sync-data/

# Documentation site: copied from the repository on every docs build (apps/docs/scripts/docs-content.mjs), and the
# Fumadocs output. Edit the source, never these copies.
apps/docs/.source/
apps/docs/.generated/
apps/docs/content/docs/operations/runbooks/
apps/docs/content/docs/reference/decisions/
apps/docs/content/docs/reference/mcp-tools/
apps/docs/content/docs/reference/keyboard-shortcuts.md
apps/docs/content/docs/reference/script-api-declarations.md
apps/docs/content/docs/reference/file-format-spec.md
apps/docs/content/docs/reference/file-layout.md
apps/docs/content/docs/architecture/threat-model.md
