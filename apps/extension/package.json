{
  "name": "@vellum/extension",
  "version": "0.0.0",
  "private": true,
  "description": "VS Code extension (Cursor and Windsurf through Open VSX).",
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run src && node --test packaging.test.mjs",
    "build": "node build.mjs",
    "test:vscode": "node build.mjs --with-daemon && node test/run.mjs",
    "package:vsix": "node packaging.mjs package",
    "publish:vsix": "node packaging.mjs publish"
  },
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.140.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/vscode": "catalog:",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.6.0",
    "esbuild": "0.28.2",
    "ovsx": "0.10.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "displayName": "Vellum",
  "publisher": "vellum",
  "categories": [
    "Visualization"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCustomEditor:vellum.design",
    "onView:vellum.recent",
    "onView:vellum.sessions"
  ],
  "dependencies": {
    "@vellum/config": "workspace:*",
    "@vellum/editor-core": "workspace:*",
    "@vellum/editor-react": "workspace:*",
    "@vellum/engine-client": "workspace:*",
    "@vellum/host-api": "workspace:*",
    "@vellum/host-vscode": "workspace:*",
    "@vellum/types-ts": "workspace:*",
    "@vellum/ui-tokens": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "vellum.design",
        "displayName": "Vellum",
        "selector": [
          {
            "filenamePattern": "*.vellum"
          },
          {
            "filenamePattern": "*.lib.vellum"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "vellum.newDesign",
        "title": "New Design File",
        "category": "Vellum"
      },
      {
        "command": "vellum.toggleView",
        "title": "Toggle Design / Text View",
        "category": "Vellum"
      },
      {
        "command": "vellum.openWelcome",
        "title": "Open Welcome File",
        "category": "Vellum"
      },
      {
        "command": "vellum.pauseAllAgents",
        "title": "Pause All Agents",
        "category": "Vellum"
      },
      {
        "command": "vellum.connectAgents",
        "title": "Connect Agents",
        "category": "Vellum"
      },
      {
        "command": "vellum.refreshSidebar",
        "title": "Refresh Sidebar",
        "category": "Vellum",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "Vellum",
      "properties": {
        "vellum.matchEditorColours": {
          "type": "boolean",
          "default": false,
          "description": "Match editor colours for chrome surfaces and text."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vellum",
          "title": "Vellum",
          "icon": "media/canvas.svg"
        }
      ]
    },
    "views": {
      "vellum": [
        {
          "id": "vellum.recent",
          "name": "Recent designs"
        },
        {
          "id": "vellum.sessions",
          "name": "Agent sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vellum.recent",
        "contents": "[New Design File](command:vellum.newDesign)\\n[Open Welcome File](command:vellum.openWelcome)\\n[Connect Agents](command:vellum.connectAgents)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vellum.refreshSidebar",
          "when": "view == vellum.sessions",
          "group": "navigation"
        },
        {
          "command": "vellum.connectAgents",
          "when": "view == vellum.recent",
          "group": "navigation"
        }
      ]
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Vellum starts a bundled local daemon."
    },
    "virtualWorkspaces": false
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/emmanuelorobinson/vellum.git",
    "directory": "apps/extension"
  }
}
