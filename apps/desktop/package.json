{
  "name": "@vellum/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Desktop app (Electron).",
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run src && node --test packaging.test.mjs",
    "build": "node build.mjs",
    "dev": "node build.mjs --with-daemon && electron dist/main/index.cjs",
    "test:electron": "node build.mjs --with-daemon && playwright test --config test/playwright.config.ts",
    "package:desktop": "node packaging.mjs"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "electron": "catalog:",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "main": "./dist/main/index.cjs",
  "dependencies": {
    "@vellum/config": "workspace:*",
    "@vellum/editor-core": "workspace:*",
    "@vellum/editor-react": "workspace:*",
    "@vellum/engine-client": "workspace:*",
    "@vellum/host-api": "workspace:*",
    "@vellum/host-electron": "workspace:*",
    "@vellum/host-vscode": "workspace:*",
    "@vellum/ui-tokens": "workspace:*",
    "electron-updater": "6.8.9",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "license": "Apache-2.0"
}
