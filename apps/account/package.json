{
  "name": "@vellum/account",
  "version": "0.0.0",
  "private": true,
  "description": "Account app (Next.js): sign-up, billing, dashboard.",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node ../../scripts/web-assets.mjs account && NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start -p 3000",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node test/browser.mjs"
  },
  "dependencies": {
    "@vellum/config": "workspace:*",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@vellum/auth": "workspace:*",
    "@vellum/billing": "workspace:*",
    "@vellum/mail": "workspace:*",
    "@vellum/ui-tokens": "workspace:*",
    "@vellum/editor-react": "workspace:*",
    "@vellum/host-browser": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@playwright/test": "catalog:"
  }
}
