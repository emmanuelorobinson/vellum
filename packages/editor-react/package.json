{
  "name": "@vellum/editor-react",
  "version": "0.0.0",
  "private": true,
  "description": "Editor UI built on shadcn and Base UI over editor-core.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./harness": "./src/harness.tsx"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run --project unit",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project storybook",
    "test:goldens": "node ../../scripts/component-goldens.mjs",
    "harness:check": "node ../../scripts/component-harness.mjs --check",
    "harness:generate": "node ../../scripts/component-harness.mjs",
    "test:e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/node": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "@playwright/test": "catalog:",
    "storybook": "catalog:",
    "vite": "catalog:"
  },
  "dependencies": {
    "react": "catalog:",
    "@base-ui/react": "catalog:",
    "@vellum/config": "workspace:*",
    "@vellum/editor-core": "workspace:*",
    "@vellum/types-ts": "workspace:*",
    "@vellum/renderer-api": "workspace:*",
    "react-dom": "catalog:",
    "@vellum/ui-tokens": "workspace:*",
    "@vellum/engine-client": "workspace:*",
    "@vellum/host-api": "workspace:*",
    "@vellum/host-fake": "workspace:*",
    "@vellum/host-browser": "workspace:*"
  }
}
