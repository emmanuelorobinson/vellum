{
  "name": "@vellum/spike-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Spike B (guide Prompt 5), engine half: Loro at scale and QuickJS in wasm32, for ADR-004. Spike quality.",
  "type": "module",
  "scripts": {
    "spike:build:wasm": "bash scripts/build-wasm.sh",
