    "spike:measure:script": "node scripts/measure-script.mjs",
    "spike:measure:loro-wasm": "node scripts/measure-loro-wasm.mjs",
    "spike:test:wasm": "node --test \"test/*.wasm.test.mjs\""
  }
}
