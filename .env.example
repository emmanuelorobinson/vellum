# Copy to .env.local for local development. Real values never go in this file or in git.
# Keys for local features (model providers, installed engines) live in the OS keychain, not here.

# Dev-only services from docker-compose.dev.yml (cloud apps: account, api, sync server).
DATABASE_URL=postgres://vellum:vellum-dev-only@127.0.0.1:5432/vellum
REDIS_URL=redis://127.0.0.1:6379

# Needed only by the person running `pnpm design:snapshot` (pen.dev CLI login).
PEN_CLI_KEY=

# CI and headless runs only (ARCHITECTURE section 7.8). Leave blank locally.
VELLUM_OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Developer-tool telemetry stays off.
TURBO_TELEMETRY_DISABLED=1
NEXT_TELEMETRY_DISABLED=1
